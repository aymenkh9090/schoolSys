# Copier vers .env et adapter :  cp .env.example .env

# ── Sources de données ────────────────────────────────────────────────────────
PROMETHEUS_URL=http://localhost:9090
ACTUATOR_URL=http://localhost:9091
HTTP_TIMEOUT_SECONDS=5

# ── Ollama ────────────────────────────────────────────────────────────────────
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_TEMPERATURE=0.1
OLLAMA_NUM_PREDICT=300
OLLAMA_TIMEOUT_SECONDS=90
MAX_TOOL_ITERATIONS=3

# ── RAG consigne ministérielle (circulaire n°66/2024) ─────────────────────────
CONSIGNE_CORPUS_PATH=data/corpus-consigne-2024.md
CONSIGNE_TOP_K=3
CONSIGNE_SCORE_FLOOR=0.60
CONSIGNE_SCORE_MARGIN=0.08
CONSIGNE_LEXICAL_WEIGHT=0.30

# ── Keycloak ──────────────────────────────────────────────────────────────────
KEYCLOAK_URL=http://localhost:8081
KEYCLOAK_REALM=smartschool
REQUIRED_ROLE=PLATFORM_SUPER_ADMIN
# false uniquement en développement local
AUTH_ENABLED=true

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
