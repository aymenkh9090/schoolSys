# Copier vers .env et adapter :  cp .env.example .env
# Lu automatiquement par docker compose. Pour le backend lancé hors Docker,
# exporter la variable :  export DB_PASSWORD='...'

# Mot de passe PostgreSQL de la base applicative (app-db).
# Doit être identique côté docker-compose et côté application.yml.
DB_PASSWORD=smartschool
