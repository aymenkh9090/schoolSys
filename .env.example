# Copier vers .env et adapter :  cp .env.example .env
# Lu automatiquement par docker compose. Pour le backend lancé hors Docker,
# exporter la variable :  export DB_PASSWORD='...'

# Mot de passe PostgreSQL de la base applicative (app-db).
# Doit être identique côté docker-compose et côté application.yml.
DB_PASSWORD=smartschool

# ── SMTP : mail de bienvenue avec mot de passe temporaire ──────────────────
# Lu par spring.mail.* (application.yml). Laisser vide désactive l'envoi :
# EmailServiceImpl journalise un warning et la création de compte réussit
# quand même — l'email n'est pas critique pour le parcours.
#
# Gmail refuse le mot de passe du compte : générer un mot de passe
# d'application sur https://myaccount.google.com/apppasswords (nécessite la
# validation en deux étapes), 16 caractères, à coller sans les espaces.
SMTP_USERNAME=
SMTP_PASSWORD=

# ── Pile complète en conteneurs ────────────────────────────────────────────
# Secret du client 'smartschool-backend', onglet Credentials dans Keycloak
# (cf. README §2.3). Sans lui le backend refuse de démarrer : le placeholder
# ${KC_CLIENT_SECRET} d'application.yml n'a pas de valeur par défaut.
KC_CLIENT_SECRET=

# ── Mode de lancement ──────────────────────────────────────────────────────
# Les services `backend` et `frontend` sont derrière le profil `app` du
# docker-compose.yml. COMPOSE_PROFILES est lu par docker compose lui-même :
# renseigné ici, il évite d'avoir à écrire `--profile app` à chaque commande.
#
# Tel quel, une seule commande lance les huit conteneurs :
#
#   docker compose up -d --build
#
# API_HOST indique à l'assistant IA où joindre l'API : le nom du service Docker
# en pile complète, l'hôte quand Spring Boot tourne dans l'IDE.
COMPOSE_PROFILES=app
API_HOST=backend

# Mode développement (API dans l'IDE, infra en conteneurs) : commenter les deux
# lignes ci-dessus, décommenter les deux suivantes. C'est le seul interrupteur —
# aucune autre variable ne change entre les deux modes.
#COMPOSE_PROFILES=
#API_HOST=host.docker.internal

# ── LAN_HOST : par quelle adresse Keycloak est-il vu ? ─────────────────────
# Fixe l'emetteur inscrit dans les jetons, et donc l'adresse que l'API exige.
# Les trois cotes en derivent : KC_HOSTNAME (docker-compose.yml), l'issuer-uri
# de l'API et celui de l'assistant (application.yml, docker-compose.yml).
#
# Laisser vide tant qu'on travaille au navigateur : tout retombe sur localhost.
# A renseigner avec l'IP du poste sur le reseau local des qu'un telephone entre
# en jeu, un telephone ne pouvant pas joindre « localhost » :
#
#   ip -4 addr show | grep -oP '(?<=inet )192\.168\.[0-9.]+' | head -1
#
# ATTENTION : le front lit sa propre copie dans frontend/.env.local
# (VITE_KEYCLOAK_URL). Les deux doivent designer la MEME adresse — sinon le
# navigateur obtient un jeton que l'API rejette en 401, et comme les 401 ne sont
# pas affiches, la panne ressemble a « il n'y a pas de donnees ».
LAN_HOST=
