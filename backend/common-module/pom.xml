<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>tn.schoolsys</groupId>
        <artifactId>schoolsys-platform</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <groupId>tn.schoolsys.common</groupId>
    <artifactId>schoolsys-common-module</artifactId>
    <packaging>jar</packaging>

    <dependencies>
        <!-- security-module : JwtClaimsExtractor pour TenantFilter + KeycloakIntegrationException pour GlobalExceptionHandler -->
        <dependency>
            <groupId>tn.schoolsys.security</groupId>
            <artifactId>schoolsys-security-module</artifactId>
            <version>0.0.1-SNAPSHOT</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- Nécessaire pour @Aspect (TenantHibernateFilterAspect) : le parseur de pointcuts
             AspectJ est requis même en mode proxy Spring (pas de vrai weaving AspectJ). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aop</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

</project>