<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.3.5</version>
    <relativePath/>
  </parent>

  <groupId>tn.schoolsys</groupId>
  <artifactId>schoolsys-platform</artifactId>
  <version>0.0.1-SNAPSHOT</version>
  <packaging>pom</packaging>

  <name>SchoolSys Platform Parent</name>
  <description>Parent project for school platform - WTM Tunisia</description>

  <properties>
    <java.version>21</java.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <keycloak.version>26.0.0</keycloak.version>
  </properties>

  <modules>
    <module>security-module</module>
    <module>common-module</module>
    <module>tenant-business</module>
    <module>organisation-business</module>
    <module>smartschool-api</module>
    <module>smartschool-planning</module>
    <module>absence-business</module>
  </modules>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>tn.schoolsys.security</groupId>
        <artifactId>schoolsys-security-module</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>org.keycloak</groupId>
        <artifactId>keycloak-admin-client</artifactId>
        <version>${keycloak.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

</project>
