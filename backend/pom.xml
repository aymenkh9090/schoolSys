<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.3.5</version>
    <relativePath/>
  </parent>

  <groupId>tn.schoolsys</groupId>
  <artifactId>schoolsys-platform</artifactId>
  <version>0.0.1-SNAPSHOT</version>
  <packaging>pom</packaging>

  <name>SchoolSys Platform Parent</name>
  <description>Parent project for school platform - WTM Tunisia</description>

  <properties>
    <java.version>21</java.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <keycloak.version>26.0.0</keycloak.version>

    <!-- ── Qualité ────────────────────────────────────────────────────────
         jacoco.version est piloté ici pour que tous les modules mesurent la
         couverture avec la même version de l'agent. -->
    <jacoco.version>0.8.12</jacoco.version>
    <sonar-maven-plugin.version>5.0.0.4389</sonar-maven-plugin.version>

    <!-- SonarCloud. La clé de projet et l'organisation sont celles créées à
         l'import du dépôt GitHub sur sonarcloud.io : les corriger ici si
         SonarCloud en a proposé d'autres.
         xmlReportPaths pointe vers TOUS les rapports de modules : sans cette
         ligne, Sonar affiche 0 % de couverture — c'est l'oubli classique. -->
    <sonar.organization>aymenkh9090</sonar.organization>
    <sonar.projectKey>aymenkh9090_smartschool</sonar.projectKey>
    <sonar.host.url>https://sonarcloud.io</sonar.host.url>
    <sonar.coverage.jacoco.xmlReportPaths>
      ${maven.multiModuleProjectDirectory}/coverage-report/target/site/jacoco-aggregate/jacoco.xml
    </sonar.coverage.jacoco.xmlReportPaths>
    <!-- Code généré (MapStruct) et DTO : mesurés, mais pas reprochés. -->
    <sonar.exclusions>**/target/generated-sources/**,**/dto/**</sonar.exclusions>
  </properties>

  <modules>
    <module>security-module</module>
    <module>common-module</module>
    <module>tenant-business</module>
    <module>organisation-business</module>
    <module>smartschool-api</module>
    <module>smartschool-planning</module>
    <module>absence-business</module>
    <!-- En dernier : il agrège la couverture des modules qui le précèdent. -->
    <module>coverage-report</module>
  </modules>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>tn.schoolsys.security</groupId>
        <artifactId>schoolsys-security-module</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>org.keycloak</groupId>
        <artifactId>keycloak-admin-client</artifactId>
        <version>${keycloak.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <!-- Version figée pour que `mvn sonar:sonar` soit reproductible : sans
             elle, Maven résout LATEST à chaque exécution. -->
        <plugin>
          <groupId>org.sonarsource.scanner.maven</groupId>
          <artifactId>sonar-maven-plugin</artifactId>
          <version>${sonar-maven-plugin.version}</version>
        </plugin>
      </plugins>
    </pluginManagement>

    <plugins>
      <!-- ── JaCoCo ────────────────────────────────────────────────────────
           prepare-agent pose l'agent AVANT surefire (phase initialize) : sans
           lui, les tests tournent mais rien n'est mesuré. report écrit le XML
           que Sonar viendra lire, en phase verify. -->
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <version>${jacoco.version}</version>
        <executions>
          <execution>
            <id>prepare-agent</id>
            <goals>
              <goal>prepare-agent</goal>
            </goals>
          </execution>
          <execution>
            <id>report</id>
            <phase>verify</phase>
            <goals>
              <goal>report</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

</project>
